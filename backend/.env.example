# Variáveis de ambiente de PRODUÇÃO do backend (ex.: painel do Render).
# Localmente NÃO é preciso definir nada — o application.yml já tem defaults de dev.
# Copie para .env e preencha com valores reais (NÃO comite o .env).

# Ativa o perfil de produção (logging enxuto)
SPRING_PROFILES_ACTIVE=prod

# Porta — o Render injeta automaticamente; não precisa setar manualmente lá.
# PORT=8080

# --- Banco (Neon) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>.neon.tech/ticketflow?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon_user>
SPRING_DATASOURCE_PASSWORD=<neon_password>

# --- RabbitMQ (CloudAMQP) — URL amqps completa ---
SPRING_RABBITMQ_ADDRESSES=amqps://<user>:<pass>@<host>.cloudamqp.com/<vhost>

# --- Segredos da aplicação ---
# JWT em Base64 (256 bits): gere com `openssl rand -base64 32`
APP_SECURITY_JWT_SECRET_KEY=<base64-256-bit-key>
APP_WEBHOOK_SECRET=<segredo-hmac-webhook>
APP_TICKET_SECRET=<segredo-hmac-ingresso>

# URL do próprio backend (o gateway simulado entrega o webhook nela)
APP_WEBHOOK_URL=https://<seu-backend>.onrender.com/api/webhooks/payments

# Origem do frontend para o CORS (URL da Vercel; aceita várias separadas por vírgula)
APP_CORS_ALLOWED_ORIGINS=https://<seu-front>.vercel.app
